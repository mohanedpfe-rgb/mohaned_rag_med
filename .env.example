PROJECT_ROOT=.
DEVICE_MODE=i5_16gb
# Required to unlock the Streamlit UI. Keep this secret and at least 12 characters.
BOOKRAG_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# Remote Ollama is allowed only when its exact hostname is listed here.
BOOKRAG_OLLAMA_ALLOWLIST=
# Maximum PDF pages accepted by ingestion (default 500; hard cap 5000).
BOOKRAG_MAX_PDF_PAGES=500
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
GENERATION_MODEL=llama3.2:3b
GENERATION_TIMEOUT_SECONDS=180
GENERATION_LATENCY_BUDGET_SECONDS=60
GENERATION_MAX_OUTPUT_TOKENS=512
OLLAMA_RETRY_BUDGET_SECONDS=60
OLLAMA_MAX_ATTEMPTS=3
INCOMING_DIR=data/incoming
PROCESSED_DIR=data/processed
FAILED_DIR=data/failed
ARCHIVE_DIR=data/archive
VECTOR_DB_DIR=data/vector_db
LOG_DIR=logs
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=6
TEMPERATURE=0.2
INGESTION_DB_PATH=data/ingestion.sqlite3
PAGE_BATCH_SIZE=16
CHUNK_BATCH_SIZE=32
EMBEDDING_BATCH_SIZE=4
EMBEDDING_RETRIES=4
EMBEDDING_TIMEOUT_SECONDS=180
EMBEDDING_TEST_MODE=false
LEXICAL_MODE=hybrid
VECTOR_WEIGHT=0.7
CONTEXT_TOKEN_BUDGET=3200
NEIGHBOR_EXPANSION=true
CONTEXTUAL_RETRIEVAL=true
MAX_WORKERS=2
MAX_MEMORY_TARGET=1024
EMBEDDING_CACHE_SIZE=128
EMBEDDING_CACHE_TTL_SECONDS=900
INGESTION_LEASE_SECONDS=900
LOG_LEVEL=INFO
OLLAMA_CONCURRENCY=1
OLLAMA_FAILURE_CIRCUIT_THRESHOLD=5
OLLAMA_CIRCUIT_OPEN_SECONDS=30.0
OCR_ENABLED=true
AUTO_OCR=true
UNIVERSAL_PDF_MODE=true
OCR_CONFIDENCE_THRESHOLD=0.55
OCR_MIN_CHAR_DENSITY=0.001
OCR_IMAGE_COVERAGE_THRESHOLD=0.55
LAZY_MODEL_LOADING=true
RETRIEVAL_CANDIDATE_MULTIPLIER=5
EVIDENCE_MIN_CONFIDENCE=0.25
ANSWER_VERIFICATION_ENABLED=true
NUMERIC_VERIFICATION_ENABLED=true
CONTRADICTION_DETECTION_ENABLED=true
QUERY_DECOMPOSITION_ENABLED=true
MULTI_QUERY_RETRIEVAL_ENABLED=true
MAX_QUERY_VARIANTS=8
RAG_PAGE_TIMEOUT=30
RAG_TABLE_TIMEOUT=5
RAG_OCR_TIMEOUT=45
RAG_OCR_MAX_PIXELS=12000000
RAG_CLEAR_DRAIN_TIMEOUT=120
